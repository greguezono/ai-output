<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.greguezono.ai-output-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/guezono/code/personal/ai-output/scripts/refresh.py</string>
        <string>--publish</string>
        <string>--if-stale</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/Users/guezono/Library/Logs/ai-output-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/guezono/Library/Logs/ai-output-refresh.log</string>
</dict>
</plist>
